global:
  scrape_interval: 15s # Try retrieve data every 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090'] # Self-monitoring

  - job_name: 'node_exporter'
    static_configs:
      - targets: ['{{ ansible_host }}:9100'] # Monitor current VPS (if node_exporter installed)

  - job_name: 'node_status'
    static_configs:
      - targets: ['localhost:9100'] # In case install in the same VPS with Prometheus